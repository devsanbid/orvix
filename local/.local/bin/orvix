#!/usr/bin/env bash
# orvix - Dotfiles management CLI

# The repo this script is in (~/.local/bin/orvix is a link into it), unless
# ORVIX_DIR says otherwise (the tests' sandboxes)
DOTS_DIR="${ORVIX_DIR:-$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.." && pwd)}"
CMD_DIR="$DOTS_DIR/.data/orvix-cli/commands"

# orvix_state_set and orvix_state_replace, for the commands and migrations
source "$DOTS_DIR/.data/orvix-cli/lib/state.sh"
# A terminal from before the current Hyprland session: its variables
source "$DOTS_DIR/.data/orvix-cli/lib/session-env.sh"
orvix_session_env

cmd="${1:-help}"
[[ "$cmd" == "--help" || "$cmd" == "-h" ]] && cmd="help"
shift 2>/dev/null || true

cmd_file="$CMD_DIR/$cmd.sh"
if [[ -f "$cmd_file" ]]; then
    # Run inside a function so 'local' and 'return' work in sourced files
    _orvix_run() {
        source "$cmd_file" "$@"
    }
    _orvix_run "$@"
else
    echo "orvix: unknown command '$cmd'"
    echo "Run 'orvix help' for usage information."
    exit 1
fi
